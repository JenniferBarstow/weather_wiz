<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Weather Wiz</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
  <%= stylesheet_link_tag 'application', media: 'all' %>  <!-- Your custom styles -->
</head>
<body>
  <div class="container">
    <h1>Weather Wiz</h1>

    <% if flash[:error] %>
      <div class="alert alert-danger"><%= flash[:error] %></div>
    <% end %>

    <% if flash[:info] %>
      <div class="alert alert-info"><%= flash[:info] %></div>
    <% end %>

    <%= form_with url: '/weather', method: :get, local: true do |form| %>
      <div class="mb-3">
        <%= form.label :address, "Enter Address:" %>
        <%= form.text_field :address, class: 'form-control', required: true %>
      </div>
      <%= form.submit "Get Weather", class: 'btn btn-primary' %>
    <% end %>

    <% if @cached_weather.present?%>
      <h2>Current Weather:</h2>
      <p>Temperature: <%= @temperature.round(1) %> °F</p>
      <p>Description: <%= @description.capitalize %></p>
      <p>Humidity: <%= @humidity %> %</p>
      <p>Wind Speed: <%= @wind_speed %> m/s</p>

      <h3>Today's High and Low:</h3>
      <p>High: <%= @daily_forecast.first[:high].round(1) %> °F</p> <!-- Today's high temperature -->
      <p>Low: <%= @daily_forecast.first[:low].round(1) %> °F</p>   <!-- Today's low temperature -->

      <h3>Extended Forecast:</h3>
      <% @daily_forecast.each do |day| %>
        <p><%= day[:date] %>: High: <%= day[:high].round(1) %> °F, Low: <%= day[:low].round(1) %> °F</p>
      <% end %>
    <% end %>
  </div>

  <!-- Include Bootstrap's bundle from CDN -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  <%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
</body>
</html>
